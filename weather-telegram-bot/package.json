{
  "name": "weather-telegram-bot",
  "version": "1.0.0",
  "description": "A bot that sends weather updates to Telegram groups",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "ts-node src/index.ts test",
    "send": "ts-node src/index.ts send",
    "help": "ts-node src/index.ts help"
  },
  "keywords": ["weather", "telegram", "bot", "automation"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "node-telegram-bot-api": "^0.66.0",
    "axios": "^1.6.2",
    "node-cron": "^3.0.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/node-telegram-bot-api": "^0.64.7",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}