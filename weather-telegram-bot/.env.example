# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_group_chat_id_here

# Weather API Configuration (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_api_key_here
CITY=your_city_name
COUNTRY_CODE=your_country_code

# Schedule Configuration (cron format)
# Default: 8:00 AM every day
WEATHER_SCHEDULE=0 8 * * *

# Optional: Temperature unit (metric, imperial, kelvin)
TEMPERATURE_UNIT=metric